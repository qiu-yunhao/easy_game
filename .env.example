# ──────────────────────────────────────────────────────────────
# easy_game 运行时环境配置模板
# 用法：复制本文件为 .env，填入真实值。.env 已被 .gitignore 忽略，不入库。
# 启动时 env_bootstrap.ensure_environment() 会加载并校验这些变量。
# ──────────────────────────────────────────────────────────────

# ── DeepSeek LLM（BaseAgent 读取，变量名不可改）──
# base_url 用 DeepSeek 官方端点；model 常用 deepseek-chat / deepseek-reasoner。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=            # 必填：DeepSeek 控制台生成的 sk-xxx
LLM_MODEL_ID=deepseek-chat
LLM_TIMEOUT_SECONDS=300

# ── 结构化分表（MySQL，StoryTemplate 4 张模板表）──
# 驱动 pymysql；把 YOUR_MYSQL_PASSWORD 换成 root 用户真实密码。
MYSQL_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/easygame_test

# ── 向量片段（PostgreSQL + pgvector；使用 PG17 的 5432 端口）──
# 把 YOUR_PG_PASSWORD 换成 postgres 用户真实密码。
PG_URL=postgresql+psycopg://postgres:YOUR_PG_PASSWORD@localhost:5432/easygame_test

# ── 存档库（Persistence 存档槽/快照，走 MySQL）──
# 同样替换 YOUR_MYSQL_PASSWORD。
STAGEBOUND_DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/easygame_test

# ── 回忆栈（RAG，走 PostgreSQL + pgvector）──
# 同样替换 YOUR_PG_PASSWORD。
STAGEBOUND_RECALL_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PG_PASSWORD@localhost:5432/easygame_test

# ── bge embedding（可选）──
# 国内下载模型加速镜像；模型已缓存后此项非必需。
HF_ENDPOINT=https://hf-mirror.com

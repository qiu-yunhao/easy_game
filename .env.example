# ──────────────────────────────────────────────────────────────
# easy_game 运行时环境配置模板
# 用法：复制本文件为 .env，填入真实值。.env 已被 .gitignore 忽略，不入库。
# 启动时 env_bootstrap.ensure_environment() 会加载并校验这些变量。
# ──────────────────────────────────────────────────────────────

# ── DeepSeek LLM（BaseAgent 读取，变量名不可改）──
# base_url 用 DeepSeek 官方端点；model 常用 deepseek-chat / deepseek-reasoner。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=            # 必填：DeepSeek 控制台生成的 sk-xxx
LLM_MODEL_ID=deepseek-chat
LLM_TIMEOUT_SECONDS=300

# ── 结构化分表（MySQL，StoryTemplate 4 张模板表）──
# 本机 Homebrew MySQL 8，root 免密；驱动 pymysql。
MYSQL_URL=mysql+pymysql://root@localhost:3306/easygame_test

# ── 向量片段（PostgreSQL + pgvector）──
PG_URL=postgresql+psycopg://qiuyunhao.1@localhost:5432/easygame_test

# ── bge embedding（可选）──
# 国内下载模型加速镜像；模型已缓存后此项非必需。
HF_ENDPOINT=https://hf-mirror.com
